<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <!-- caffeine enums copied from caffeine extension v60 -->
  <enum id="org.gnome.shell.extensions.spotlight.caffeine.context-control">
    <value value="0" nick="never"/>
    <value value="1" nick="always"/>
    <value value="2" nick="for-apps"/>
  </enum>
  <enum id="org.gnome.shell.extensions.spotlight.caffeine.show-indicator">
    <value value="0" nick="only-active"/>
    <value value="1" nick="always"/>
    <value value="2" nick="never"/>
  </enum>
  <enum id="org.gnome.shell.extensions.spotlight.caffeine.app-trigger-mode">
    <value value="0" nick="on-running"/>
    <value value="1" nick="on-focus"/>
    <value value="2" nick="on-active-workspace"/>
  </enum>

  <schema id="org.gnome.shell.extensions.spotlight" path="/org/gnome/shell/extensions/spotlight/">
    <!-- default is ctrl space super space has timing issues on some gnome 50 setups -->
    <key name="toggle-shortcut" type="as">
      <default>['&lt;Control&gt;space']</default>
      <summary>Toggle shortcut</summary>
      <description>Keyboard shortcut to open Spotlight. Default is Ctrl+Space.</description>
    </key>
    <!-- appearance theme default follows gnome system dark forces dark light forces light -->
    <key name="theme-preference" type="s">
      <default>'default'</default>
      <summary>Theme preference</summary>
      <description>Color theme for Spotlight. Values: default (follows system), dark, light.</description>
    </key>
    <!-- clipboard view shortcut default alt 1 -->
    <key name="clipboard-shortcut" type="as">
      <default>['&lt;Alt&gt;1']</default>
      <summary>Clipboard view shortcut</summary>
      <description>Keyboard shortcut to open Spotlight in clipboard history mode.</description>
    </key>
    <!-- emoji view shortcut default alt 2 -->
    <key name="emoji-shortcut" type="as">
      <default>['&lt;Alt&gt;2']</default>
      <summary>Emoji view shortcut</summary>
      <description>Keyboard shortcut to open Spotlight in emoji selector mode.</description>
    </key>
    <!-- clipboard history size -->
    <key name="clipboard-history-size" type="i">
      <default>20</default>
      <summary>Clipboard history size</summary>
      <description>Maximum number of entries to keep in clipboard history.</description>
      <range min="5" max="100"/>
    </key>
    <!-- recently used emojis -->
    <key name="recently-used-emojis" type="as">
      <default>[]</default>
      <summary>Recently used emojis</summary>
      <description>Emojis recently selected by the user.</description>
    </key>
    <!-- paste on select automatically paste after selecting clipboard entry or emoji -->
    <key name="paste-on-select" type="b">
      <default>false</default>
      <summary>Paste on select</summary>
      <description>Automatically paste after selecting a clipboard history entry or emoji.</description>
    </key>
    <!-- emoji skin tone 0 none 1 light 2 medium light 3 medium 4 medium dark 5 dark -->
    <key name="emoji-skin-tone" type="i">
      <default>0</default>
      <summary>Emoji skin tone</summary>
      <description>Default skin tone modifier for applicable emojis. 0 = none, 1-5 = light to dark.</description>
      <range min="0" max="5"/>
    </key>
    <!-- emoji gender 0 none 1 women 2 men -->
    <key name="emoji-gender" type="i">
      <default>0</default>
      <summary>Emoji gender</summary>
      <description>Default gender modifier for applicable emojis. 0 = none, 1 = women, 2 = men.</description>
      <range min="0" max="2"/>
    </key>
    <!-- emoji click counts for popularity ranking stored as json string -->
    <key name="emoji-click-counts" type="s">
      <default>''</default>
      <summary>Emoji click counts</summary>
      <description>JSON mapping of emoji characters to click counts for search ranking.</description>
    </key>

    <!-- === caffeine keys copied from caffeine extension v60 === -->
    <key type="as" name="inhibit-apps">
      <default>[ ]</default>
      <summary>Application list</summary>
      <description>A list of strings each containing an application id desktop file name</description>
    </key>
    <key type="b" name="user-enabled">
      <default>false</default>
      <summary>Store caffeine user state</summary>
      <description></description>
    </key>
    <key type="ai" name="duration-timer-list">
      <default>[900, 1800, 3600]</default>
      <summary>List of duration timer</summary>
      <description>Specify the short medium and long duration for the timer countdown in seconds</description>
    </key>
    <key type="b" name="use-custom-duration">
      <default>false</default>
      <summary>Use custom duration values for the timer</summary>
      <description></description>
    </key>
    <key type="i" name="countdown-timer">
      <default>0</default>
      <summary>Specify time in seconds for the timer countdown</summary>
      <description>Specify time in seconds for the timer countdown</description>
    </key>
    <key type="i" name="duration-timer">
      <default>2</default>
      <summary>Specify index of duration range for the timer</summary>
      <description>Specify index of duration range for the timer</description>
    </key>
    <key type="b" name="restore-state">
      <default>false</default>
      <summary>Restore caffeine state</summary>
      <description></description>
    </key>
    <key name="show-indicator" enum="org.gnome.shell.extensions.spotlight.caffeine.show-indicator">
      <default>"only-active"</default>
      <summary>Show indicator</summary>
      <description>Show the indicator on the top panel</description>
    </key>
    <key type="b" name="show-notifications">
      <default>true</default>
      <summary>Show notifications</summary>
      <description>Show notifications when enabled or disabled</description>
    </key>
    <key type="b" name="show-timer">
      <default>true</default>
      <summary>Show timer</summary>
      <description>Show timer when enabled or disabled</description>
    </key>
    <key type="b" name="show-toggle">
      <default>true</default>
      <summary>Show toggle</summary>
      <description>Show the quick settings toggle</description>
    </key>
    <key type="b" name="enable-fullscreen">
      <default>true</default>
      <summary>Enable when a fullscreen application is running</summary>
      <description>Enable when a fullscreen application is running</description>
    </key>
    <key type="b" name="enable-mpris">
      <default>false</default>
      <summary>Enable when an application is playing media</summary>
      <description>Enable when an application is reporting playback status via MPRIS</description>
    </key>
    <key name="nightlight-control" enum="org.gnome.shell.extensions.spotlight.caffeine.context-control">
      <default>"never"</default>
      <summary>Night Light control mode</summary>
      <description>Set the way Caffeine interacts with the Night light setting</description>
    </key>
    <key name="screen-blank" enum="org.gnome.shell.extensions.spotlight.caffeine.context-control">
      <default>"never"</default>
      <summary>Allow screen blank</summary>
      <description>Allow turning off screen when Caffeine is enabled</description>
    </key>
    <key name="trigger-apps-mode" enum="org.gnome.shell.extensions.spotlight.caffeine.app-trigger-mode">
      <default>"on-running"</default>
      <summary>Trigger App control mode</summary>
      <description>Set the trigger method for apps</description>
    </key>
    <key type="as" name="caffeine-toggle-shortcut">
      <default><![CDATA[[]]]></default>
      <summary>Caffeine toggle shortcut</summary>
      <description>Shortcut to toggle Caffeine</description>
    </key>
    <key type="i" name="prefs-default-width">
      <default>570</default>
      <summary>Default width for the preferences window</summary>
    </key>
    <key type="i" name="prefs-default-height">
      <default>590</default>
      <summary>Default height for the preferences window</summary>
    </key>
    <key type="i" name="indicator-position">
      <default>0</default>
      <summary>Visible position offset of status icon in indicator menu</summary>
    </key>
    <key type="i" name="indicator-position-index">
      <default>0</default>
      <summary>Real position offset of status icon in indicator menu that include invisible one</summary>
    </key>
    <key type="i" name="indicator-position-max">
      <default>1</default>
      <summary>Last item index in indicator menu</summary>
    </key>
    <key type="b" name="caffeine-enabled">
      <default>false</default>
      <summary>Enable Caffeine</summary>
      <description>When enabled Caffeine prevents screen blanking and auto suspend. When disabled Caffeine has no impact on the system.</description>
    </key>
    <key type="b" name="cli-toggle">
      <default>false</default>
      <summary>Command line key to toggle state</summary>
    </key>

    <!-- === clipboard indicator features === -->
    <key type="b" name="clipboard-private-mode">
      <default>false</default>
      <summary>Private mode</summary>
      <description>When enabled clipboard changes are not tracked in history</description>
    </key>
    <key type="b" name="clipboard-move-first">
      <default>true</default>
      <summary>Move selected item to top</summary>
      <description>Move items to the top of the list when selected</description>
    </key>
    <key type="b" name="clipboard-strip-text">
      <default>false</default>
      <summary>Strip whitespace</summary>
      <description>Remove leading and trailing whitespace from copied text</description>
    </key>
    <key type="b" name="clipboard-confirm-clear">
      <default>true</default>
      <summary>Confirm before clearing history</summary>
      <description>Show confirmation dialog when clearing clipboard history</description>
    </key>
    <key type="b" name="clipboard-confirm-pinned-delete">
      <default>false</default>
      <summary>Confirm before deleting pinned items</summary>
      <description>Show confirmation dialog when deleting a pinned favorite item</description>
    </key>
    <key type="b" name="clipboard-regex-search">
      <default>false</default>
      <summary>Regex search</summary>
      <description>Allow regular expressions in clipboard search</description>
    </key>
    <key type="b" name="clipboard-case-sensitive">
      <default>false</default>
      <summary>Case sensitive search</summary>
      <description>Make clipboard search case sensitive</description>
    </key>
    <key type="b" name="clipboard-cache-only-favorites">
      <default>false</default>
      <summary>Cache only favorites</summary>
      <description>Only persist favorite pinned entries to disk non favorites are memory only</description>
    </key>
    <key type="b" name="clipboard-pinned-on-bottom">
      <default>false</default>
      <summary>Pinned items on bottom</summary>
      <description>Display the pinned favorites section below the history section</description>
    </key>
    <key type="b" name="clipboard-show-pin-button">
      <default>true</default>
      <summary>Show pin button</summary>
      <description>Show the pin favorite button on each clipboard item</description>
    </key>
    <key type="b" name="clipboard-show-delete-button">
      <default>true</default>
      <summary>Show delete button</summary>
      <description>Show the delete button on each clipboard item</description>
    </key>
    <key type="b" name="clipboard-show-paste-button">
      <default>true</default>
      <summary>Show paste button</summary>
      <description>Show the paste button on each clipboard item</description>
    </key>
    <key type="b" name="clipboard-show-edit-button">
      <default>true</default>
      <summary>Show edit button</summary>
      <description>Show the edit button on text clipboard items</description>
    </key>
    <key type="b" name="clipboard-show-tag-button">
      <default>true</default>
      <summary>Show tag button</summary>
      <description>Show the tag button on each clipboard item</description>
    </key>
    <key type="as" name="clipboard-excluded-apps">
      <default>[]</default>
      <summary>Excluded applications</summary>
      <description>Applications whose clipboard changes are not tracked in history</description>
    </key>

    <!-- === emoji copy features === -->
    <key type="i" name="emoji-size">
      <default>28</default>
      <summary>Emoji size</summary>
      <description>Size of emoji buttons in pixels</description>
      <range min="16" max="48"/>
    </key>
    <key type="i" name="emoji-columns">
      <default>10</default>
      <summary>Emoji columns</summary>
      <description>Number of emojis per row in the grid</description>
      <range min="6" max="16"/>
    </key>
    <key type="b" name="emoji-keep-open">
      <default>false</default>
      <summary>Keep emoji panel open</summary>
      <description>Keep the emoji panel open after selecting an emoji allows picking multiple</description>
    </key>
    <key type="b" name="emoji-show-tooltips">
      <default>true</default>
      <summary>Show emoji tooltips</summary>
      <description>Show emoji name tooltips on hover</description>
    </key>
    <key type="as" name="emoji-recently-used">
      <default>[]</default>
      <summary>Recently used emojis</summary>
      <description>Emojis recently selected by the user</description>
    </key>


    <!-- === space bar standalone feature === -->
    <key type="b" name="space-bar-enabled">
      <default>false</default>
      <summary>Enable Workspaces Bar</summary>
      <description>Replaces the top-panel workspace indicator with an i3-like workspaces bar</description>
    </key>

    <!-- === disable dash feature === -->
    <key type="b" name="disable-dash">
      <default>false</default>
      <summary>Disable the dash</summary>
      <description>Hide the GNOME dash dock in the overview</description>
    </key>


    <!-- === workspaces bar space-bar-state-keys === -->
<key name="space-bar-state-version" type="i">
            <default>0</default>
        </key>
        <key name="space-bar-state-workspace-names-map" type="s">
            <default><![CDATA['{}']]></default>
        </key>
    
    <!-- === workspaces bar space-bar-behavior-keys === -->
<key name="space-bar-behavior-indicator-style" type="s">
            <choices>
                <!-- Not valid anymore, included for migration. -->
                <choice value="current-workspace-name" />
                <choice value="current-workspace" />
                <choice value="workspaces-bar" />
            </choices>
            <default>"workspaces-bar"</default>
            <summary>Indicator style</summary>
        </key>
        <key name="space-bar-behavior-enable-custom-label" type="b">
            <default>false</default>
        </key>
        <key name="space-bar-behavior-enable-custom-label-in-menu" type="b">
            <default>false</default>
        </key>
        <key name="space-bar-behavior-custom-label-named" type="s">
            <default>'{{name}}'</default>
        </key>
        <key name="space-bar-behavior-custom-label-unnamed" type="s">
            <default>'Workspace {{number}}'</default>
        </key>
        <key name="space-bar-behavior-position" type="s">
            <choices>
                <choice value="left" />
                <choice value="center" />
                <choice value="right" />
            </choices>
            <default>"left"</default>
            <summary>Position in top panel</summary>
        </key>
        <key name="space-bar-behavior-system-workspace-indicator" type="b">
            <default>false</default>
        </key>
        <key name="space-bar-behavior-position-index" type="i">
            <range min="0" max="100" />
            <default>1</default>
            <summary>Position index</summary>
            <description>Order relative to other elements</description>
        </key>
        <key name="space-bar-behavior-always-show-numbers" type="b">
            <default>false</default>
        </key>
        <key name="space-bar-behavior-show-empty-workspaces" type="b">
            <default>true</default>
        </key>
        <key name="space-bar-behavior-toggle-overview" type="b">
            <default>true</default>
        </key>
        <key name="space-bar-behavior-scroll-wheel" type="s">
            <choices>
                <choice value="panel" />
                <choice value="workspaces-bar" />
                <choice value="disabled" />
            </choices>
            <default>"panel"</default>
            <summary>Switch workspaces with scroll wheel</summary>
        </key>
        <key name="space-bar-behavior-scroll-wheel-debounce" type="b">
            <default>true</default>
        </key>
        <key name="space-bar-behavior-scroll-wheel-debounce-time" type="i">
            <default>200</default>
        </key>
        <key name="space-bar-behavior-scroll-wheel-vertical" type="s">
            <choices>
                <choice value="normal" />
                <choice value="inverted" />
                <choice value="disabled" />
            </choices>
            <default>"normal"</default>
        </key>
        <key name="space-bar-behavior-scroll-wheel-horizontal" type="s">
            <choices>
                <choice value="normal" />
                <choice value="inverted" />
                <choice value="disabled" />
            </choices>
            <default>"disabled"</default>
        </key>
        <key name="space-bar-behavior-scroll-wheel-wrap-around" type="b">
            <default>false</default>
        </key>
        <key name="space-bar-behavior-smart-workspace-names" type="b">
            <default>false</default>
        </key>
        <key name="space-bar-behavior-reevaluate-smart-workspace-names" type="b">
            <default>true</default>
        </key>
    
    <!-- === workspaces bar space-bar-appearance-keys === -->
<!-- General Appearance Settings -->
