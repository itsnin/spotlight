    <!-- === workspaces bar space-bar-shortcuts-keys === -->
<key name="space-bar-shortcuts-enable-activate-workspace-shortcuts" type="b">
            <default>false</default>
        </key>
        <key name="space-bar-shortcuts-back-and-forth" type="b">
