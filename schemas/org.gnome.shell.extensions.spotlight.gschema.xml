    </key>
    <key type="i" name="indicator-position-index">
      <default>0</default>
      <summary>Real position offset of status icon in indicator menu that include invisible one</summary>
    </key>
    <key type="i" name="indicator-position-max">
      <default>1</default>
      <summary>Last item index in indicator menu</summary>
    </key>
    <key type="b" name="caffeine-enabled">
      <default>false</default>
      <summary>Enable Caffeine</summary>
      <description>When enabled Caffeine prevents screen blanking and auto suspend. When disabled Caffeine has no impact on the system.</description>
    </key>
    <key type="b" name="cli-toggle">
      <default>false</default>
      <summary>Command line key to toggle state</summary>
    </key>

