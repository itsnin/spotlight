<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="org.gnome.shell.extensions.spotlight" path="/org/gnome/shell/extensions/spotlight/">
        <!-- main toggle shortcut default ctrl space -->
        <key name="toggle-shortcut" type="as">
            <default><![CDATA[['<Ctrl>space']]]></default>
            <summary>Shortcut to toggle Spotlight</summary>
            <description>Keyboard shortcut that opens and closes the Spotlight popup.</description>
        </key>

        <!-- appearance theme default follows gnome system dark and light force specific -->
        <key name="theme-preference" type="s">
            <default>'default'</default>
            <summary>Color theme preference</summary>
            <description>Color theme for Spotlight. Values: default (follows system), dark, light.</description>
        </key>
    </schema>
</schemalist>
