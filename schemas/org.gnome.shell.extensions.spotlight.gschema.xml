<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <!-- caffeine enums copied from caffeine extension v60 -->
  <enum id="org.gnome.shell.extensions.spotlight.caffeine.context-control">
    <value value="0" nick="never"/>
    <value value="1" nick="always"/>
    <value value="2" nick="for-apps"/>
  </enum>
  <enum id="org.gnome.shell.extensions.spotlight.caffeine.show-indicator">
    <value value="0" nick="only-active"/>
    <value value="1" nick="always"/>
    <value value="2" nick="never"/>
  </enum>
  <enum id="org.gnome.shell.extensions.spotlight.caffeine.app-trigger-mode">
    <value value="0" nick="on-running"/>
    <value value="1" nick="on-focus"/>
    <value value="2" nick="on-active-workspace"/>
  </enum>

  <schema id="org.gnome.shell.extensions.spotlight" path="/org/gnome/shell/extensions/spotlight/">
    <!-- default is ctrl space super space has timing issues on some gnome 50 setups -->
    <key name="toggle-shortcut" type="as">
      <default>['&lt;Control&gt;space']</default>
      <summary>Toggle shortcut</summary>
      <description>Keyboard shortcut to open Spotlight. Default is Ctrl+Space.</description>
    </key>
    <!-- appearance theme default follows gnome system dark forces dark light forces light -->
    <key name="theme-preference" type="s">
      <default>'default'</default>
      <summary>Theme preference</summary>
      <description>Color theme for Spotlight. Values: default (follows system), dark, light.</description>
    </key>
    <!-- clipboard view shortcut default alt 1 -->
    <key name="clipboard-shortcut" type="as">
      <default>['&lt;Alt&gt;1']</default>
      <summary>Clipboard view shortcut</summary>
      <description>Keyboard shortcut to open Spotlight in clipboard history mode.</description>
    </key>
    <!-- emoji view shortcut default alt 2 -->
    <key name="emoji-shortcut" type="as">
      <default>['&lt;Alt&gt;2']</default>
      <summary>Emoji view shortcut</summary>
      <description>Keyboard shortcut to open Spotlight in emoji selector mode.</description>
    </key>
    <!-- clipboard history size -->
    
    <!-- recently used emojis -->
    <key name="recently-used-emojis" type="as">
      <default>[]</default>
      <summary>Recently used emojis</summary>
      <description>Emojis recently selected by the user.</description>
    </key>
    <!-- paste on select automatically paste after selecting clipboard entry or emoji -->
    <key name="paste-on-select" type="b">
      <default>false</default>
      <summary>Paste on select</summary>
      <description>Automatically paste after selecting a clipboard history entry or emoji.</description>
    </key>
    <!-- emoji skin tone 0 none 1 light 2 medium light 3 medium 4 medium dark 5 dark -->
    
    <!-- emoji gender 0 none 1 women 2 men -->
    
    <!-- emoji click counts for popularity ranking stored as json string -->
    

    <!-- === caffeine keys copied from caffeine extension v60 === -->
    <key type="as" name="inhibit-apps">
      <default>[ ]</default>
